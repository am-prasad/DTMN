{
  "extends": ["next/core-web-vitals"],
  "rules": {
    // Catch common bugs
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-unused-vars": "off",
    "@typescript-eslint/no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "@typescript-eslint/no-explicit-any": "warn",
    // Security
    "react/no-danger": "error",
    // Accessibility
    "jsx-a11y/alt-text": "warn"
  }
}
