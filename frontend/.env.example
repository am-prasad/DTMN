# =============================================================================
# Frontend Environment Variables — copy to .env.local and fill in real values.
# NEVER commit .env.local with real secrets.
# =============================================================================

# ----- API / Backend -----
# Server-side only (not exposed to browser) — used by Next.js server components
# and the /api/v1 proxy rewrite in next.config.mjs
BACKEND_URL=http://localhost:8000

# C5 (CSRF): In PRODUCTION leave NEXT_PUBLIC_API_URL unset.
# The /api/v1 rewrite in next.config.mjs handles routing to BACKEND_URL.
# Leaving this set in production means the browser talks cross-origin,
# bypassing SameSite=Lax cookie protection.
NEXT_PUBLIC_API_URL=http://localhost:8000   # DEV ONLY — unset in production

# Public site URL (used for metadata, robots.txt, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
